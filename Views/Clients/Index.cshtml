@model List<ServiceManager.Models.ClientListItem>
@{
    ViewData["Title"] = "Клієнти";
    var search = ViewData["Search"] as string;
}

<h1>Клієнти</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Пошук за ПІБ або телефоном" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Знайти</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
        }
    </div>
    <div class="col text-end">
        <a asp-action="Create" class="btn btn-success">Додати клієнта</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Клієнтів не знайдено.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ПІБ</th>
                <th>Телефон</th>
                <th>Ремонтів</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.FullName</td>
                    <td>@c.Phone</td>
                    <td>@c.OrdersCount</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Картка</a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}