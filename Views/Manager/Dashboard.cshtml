@model ServiceManager.Models.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Панель управління";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Панель управління (Менеджер)</h1>
    <a asp-controller="Orders" asp-action="Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-lg"></i> Створити замовлення
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat stat-green">
            <div class="title">Нові замовлення</div>
            <div class="num">@Model.NewToday</div>
            <div class="sub">Сьогодні</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-yellow">
            <div class="title">В роботі</div>
            <div class="num">@Model.InWork</div>
            <div class="sub">Всього на майстрах</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-red">
            <div class="title">У черзі</div>
            <div class="num">@Model.Queued</div>
            <div class="sub">Очікують</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-blue">
            <div class="title">Каса за місяць</div>
            <div class="num">@Model.CashMonth.ToString("N0") грн</div>
            <div class="sub">Закриті ремонти</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Останні звернення</h5>
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>ID</th><th>Клієнт</th><th>Пристрій</th><th>Статус</th><th>Майстер</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Recent)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.Client?.FullName</td>
                        <td>@o.DeviceInfo</td>
                        <td><partial name="_StatusBadge" model="o.Status" /></td>
                        <td>@(o.Technician?.Email?.Split('@')[0] ?? "—")</td>
                        <td class="text-end"><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Перегляд</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>