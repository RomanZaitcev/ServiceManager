@model ServiceManager.Models.CreateOrderViewModel
@{
    ViewData["Title"] = "Нове замовлення";
}

<h1>Нове замовлення</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Дані клієнта</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+380501234567" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                        <div class="form-text">Якщо клієнт з таким телефоном уже є, замовлення додасться до його картки.</div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Дані пристрою</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DeviceType" class="form-label"></label>
                            <input asp-for="DeviceType" class="form-control" list="deviceTypes" />
                            <datalist id="deviceTypes">
                                <option value="Смартфон"></option>
                                <option value="Ноутбук"></option>
                                <option value="Планшет"></option>
                                <option value="Комп'ютер"></option>
                                <option value="Принтер"></option>
                                <option value="Телевізор"></option>
                            </datalist>
                            <span asp-validation-for="DeviceType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DeviceInfo" class="form-label"></label>
                            <input asp-for="DeviceInfo" class="form-control" />
                            <span asp-validation-for="DeviceInfo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SerialNumber" class="form-label"></label>
                        <input asp-for="SerialNumber" class="form-control" />
                        <span asp-validation-for="SerialNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Accessories" class="form-label"></label>
                        <input asp-for="Accessories" class="form-control" placeholder="Напр.: кабель живлення, картридж" />
                        <span asp-validation-for="Accessories" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="ExternalCondition" class="form-label"></label>
                        <input asp-for="ExternalCondition" class="form-control" placeholder="Напр.: потертий корпус, брудний" />
                        <span asp-validation-for="ExternalCondition" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Технічний опис</div>
                <div class="card-body">
                    <label asp-for="ProblemDescription" class="form-label"></label>
                    <textarea asp-for="ProblemDescription" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="ProblemDescription" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Створити замовлення</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}