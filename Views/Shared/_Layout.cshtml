@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => ctrl == c ? "active" : "";

    var isAuth = User.Identity?.IsAuthenticated == true;
    var isManager = User.IsInRole("Manager");
    var isTech = User.IsInRole("Technician");
    var shortName = User.Identity?.Name?.Split('@')[0] ?? "";
    var roleLabel = isManager ? "Менеджер" : isTech ? "Майстер" : "Користувач";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - СервісЦентр</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (!isAuth)
{
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="brand"><i class="bi bi-tools"></i> СервісЦентр</div>
            @RenderBody()
        </div>
    </div>
}
else
{
    <div class="app">
        <aside class="sidebar">
            <div class="brand"><i class="bi bi-tools"></i> СервісЦентр</div>
            <nav class="nav-side">
                @if (isManager)
                {
                    <a class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Головна</a>
                    <a class="@Active("Orders")" asp-controller="Orders" asp-action="Index"><i class="bi bi-clipboard-check"></i> Замовлення</a>
                    <a class="@Active("Clients")" asp-controller="Clients" asp-action="Index"><i class="bi bi-people"></i> Клієнти</a>
                    <a class="@Active("Inventory")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam"></i> Склад</a>
                    <a class="@Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-gear"></i> Налаштування</a>
                }
                else if (isTech)
                {
                    <a class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Головна</a>
                    <a class="@Active("Orders")" asp-controller="Orders" asp-action="Index"><i class="bi bi-clipboard-check"></i> Мої замовлення</a>
                    <a class="@Active("Inventory")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam"></i> Склад</a>
                }
            </nav>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <span class="who">@roleLabel: @shortName</span>
                <span class="avatar"><i class="bi bi-person-circle"></i></span>
                <span class="date">@DateTime.Now.ToString("dd.MM.yyyy")</span>
                    <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication"
                       class="text-decoration-none small" title="Безпека облікового запису">
                        <i class="bi bi-shield-lock"></i> Безпека
                    </a>
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn-logout">Вихід</button>
                </form>
            </header>

            <main class="content">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success">@successMessage</div>
                }
                @if (TempData["Info"] is string infoMessage)
                {
                    <div class="alert alert-info">@infoMessage</div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>