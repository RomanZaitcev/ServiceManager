@model ServiceManager.Models.TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Панель майстра";
}

<h1>Панель управління (Майстер)</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat stat-green">
            <div class="title">Мої в черзі</div>
            <div class="num">@Model.Queued</div>
            <div class="sub">Очікують діагностики</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-yellow">
            <div class="title">Мої в роботі</div>
            <div class="num">@Model.InWork</div>
            <div class="sub">Зараз ремонтується</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-red">
            <div class="title">Очікують запчастин</div>
            <div class="num">@Model.AwaitingParts</div>
            <div class="sub">Призупинено</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat stat-blue">
            <div class="title">Виконано цього місяця</div>
            <div class="num">@Model.DoneMonth</div>
            <div class="sub">Успішні ремонти</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Останні звернення</h5>
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>ID</th><th>Пристрій</th><th>Опис несправності</th><th>Статус</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Recent)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.DeviceInfo</td>
                        <td>@o.ProblemDescription</td>
                        <td><partial name="_StatusBadge" model="o.Status" /></td>
                        <td class="text-end"><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Перегляд</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>